FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build
WORKDIR /src

# Build context: the Gameplane repo root, where this repo is the tunnel/
# submodule (standalone CI checks it out under tunnel/ for the same layout).
COPY tunnel/go.mod tunnel/go.sum* ./tunnel/
WORKDIR /src/tunnel
RUN go mod download

WORKDIR /src
COPY tunnel/ ./tunnel/
WORKDIR /src/tunnel

ARG VERSION=dev
# Cross-compile on the build host ($BUILDPLATFORM above) rather than under
# QEMU emulation: multi-arch release builds of the arm64 image were slow
# enough to hit the release job timeout.
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/tunnel .

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=build /out/tunnel /tunnel
USER 65532:65532
EXPOSE 25565/tcp 25565/udp
EXPOSE 8091/tcp
ENTRYPOINT ["/tunnel"]
